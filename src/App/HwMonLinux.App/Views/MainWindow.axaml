<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HwMonLinux.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="700"
        x:Class="HwMonLinux.App.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="HWMon Linux Monitor"
        x:DataType="vm:MainWindowViewModel"
        Width="1100"
        Height="720">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,0">
        <Menu Grid.Row="0">
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Margin="20,10,20,0" CornerRadius="8" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="HWMon Linux"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Updated {0:T}'}"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Refresh"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center"/>
                    <Slider Minimum="0.5"
                            Maximum="10"
                            Width="160"
                            Value="{Binding RefreshIntervalSeconds, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0:F1}s'}"
                               Width="60"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="3" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Theme"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox Width="140"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="4"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           Text="{Binding WarningText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           IsVisible="{Binding HasWarnings}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="20,16,20,0" Padding="12" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}">
            <ItemsControl ItemsSource="{Binding SensorCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="250"
                                   MinWidth="250"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorCardViewModel">
                        <Border CornerRadius="12" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="3" Margin="20,16,20,0" Padding="12" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}">
            <Grid ColumnDefinitions="*,2*" RowDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="8">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Text="Total readings" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        <TextBlock Text="{Binding TotalReadings}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Root nodes" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        <TextBlock Text="{Binding RootNodeCount}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Visible sensors" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        <TextBlock Text="{Binding VisibleSensors}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Grid.RowSpan="2" Padding="8" Background="{DynamicResource ThemeBackgroundBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Diagnostics" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ProviderDiagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderDiagnosticViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ReadingCount, StringFormat='{}{0} readings'}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                   IsVisible="{Binding HasMessage}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Provider status and reading counts update each refresh."
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="20,16,20,20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="280"
                         Watermark="Search sensors"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Reset Min/Max"
                        Command="{Binding ResetStatsCommand}"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="10"
                    CornerRadius="6"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    IsVisible="{Binding ShowEmptyState}">
                <TextBlock Text="{Binding EmptyStateHelp}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="3*,*,*,*" Margin="0,4,0,0">
                <TextBlock Text="Sensor" FontWeight="SemiBold"/>
                <TextBlock Text="Value" Grid.Column="1" FontWeight="SemiBold"/>
                <TextBlock Text="Min" Grid.Column="2" FontWeight="SemiBold"/>
                <TextBlock Text="Max" Grid.Column="3" FontWeight="SemiBold"/>
            </Grid>

            <TreeView Grid.Row="3"
                      ItemsSource="{Binding RootNodes}">
                <TreeView.ItemContainerTheme>
                    <ControlTheme x:DataType="vm:SensorTreeNode" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </ControlTheme>
                </TreeView.ItemContainerTheme>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:SensorTreeNode"
                                      ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="3*,*,*,*" Margin="0,2" IsVisible="{Binding IsVisible}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontWeight="{Binding IsLeaf, Converter={StaticResource LeafFontWeightConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayValue}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayMin}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DisplayMax}"/>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</Window>
