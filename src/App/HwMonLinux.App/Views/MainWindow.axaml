<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HwMonLinux.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="700"
        x:Class="HwMonLinux.App.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="HWMon Linux Monitor"
        x:DataType="vm:MainWindowViewModel"
        Width="1100"
        Height="720">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,0">
        <Menu Grid.Row="0">
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Margin="20,10,20,0" CornerRadius="8" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="HWMon Linux"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Updated {0:T}'}"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Refresh"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center"/>
                    <Slider Minimum="0.5"
                            Maximum="10"
                            Width="160"
                            Value="{Binding RefreshIntervalSeconds, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0:F1}s'}"
                               Width="60"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="4"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           Text="{Binding WarningText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           IsVisible="{Binding HasWarnings}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="20,16,20,0" Padding="12" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}">
            <ItemsControl ItemsSource="{Binding SensorCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="250"
                                   MinWidth="250"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorCardViewModel">
                        <Border CornerRadius="12" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="3" Margin="20,16,20,20" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="280"
                         Watermark="Search sensors"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Reset Min/Max"
                        Command="{Binding ResetStatsCommand}"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="3*,*,*,*" Margin="0,4,0,0">
                <TextBlock Text="Sensor" FontWeight="SemiBold"/>
                <TextBlock Text="Value" Grid.Column="1" FontWeight="SemiBold"/>
                <TextBlock Text="Min" Grid.Column="2" FontWeight="SemiBold"/>
                <TextBlock Text="Max" Grid.Column="3" FontWeight="SemiBold"/>
            </Grid>

            <TreeView Grid.Row="2"
                      ItemsSource="{Binding RootNodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:SensorTreeNode"
                                      ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="3*,*,*,*" Margin="0,2">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontWeight="{Binding IsLeaf, Converter={StaticResource LeafFontWeightConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayValue}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayMin}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DisplayMax}"/>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</Window>
