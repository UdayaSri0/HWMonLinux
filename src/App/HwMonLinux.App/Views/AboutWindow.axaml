<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HwMonLinux.App.Views"
        x:Class="HwMonLinux.App.Views.AboutWindow"
        x:DataType="views:AboutWindow"
        Width="400"
        Height="280"
        Title="About HWMon Linux"
        CanResize="False">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="HWMon Linux Monitor"
                   FontSize="20"
                   FontWeight="SemiBold"/>
        <Separator/>
        <TextBlock Text="Author: Udaya Sri"/>
        <TextBlock Text="GitHub: https://github.com/UdayaSri0/HWMonLinux.git"/>
        <TextBlock Text="License: MIT"/>
        <TextBlock Text="{Binding VersionText}"/>
        <TextBlock Text="HWMonitor-style hardware telemetry for modern Linux desktops."
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
        <Button Content="Close"
                HorizontalAlignment="Right"
                Width="80"
                Click="OnCloseClicked"/>
    </StackPanel>
</Window>
